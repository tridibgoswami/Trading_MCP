# ─────────────────────────────────────────────
#  COPY THIS FILE TO .env AND FILL IN YOUR VALUES
#  NEVER COMMIT .env TO GITHUB
# ─────────────────────────────────────────────

# AngelOne Credentials (regenerate after exposure)
ANGEL_API_KEY=your_new_api_key_here
ANGEL_CLIENT_ID=your_client_id
ANGEL_MPIN=your_mpin
ANGEL_TOTP_SECRET=your_new_totp_secret

# Anthropic (Claude AI)
ANTHROPIC_API_KEY=your_anthropic_key

# Telegram Alerts (optional but recommended)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Analysis Settings (this engine does not place real orders)
MAX_RISK_PER_TRADE=1000   # Risk reference value per signal in INR
MAX_DAILY_LOSS=3000        # Daily loss threshold for alerts in INR
